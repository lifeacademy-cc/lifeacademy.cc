{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifeacademy-cc",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "lifeacademy.cc", "custom_domain": true, "zone_name": "lifeacademy.cc" },
    { "pattern": "www.lifeacademy.cc", "custom_domain": true, "zone_name": "lifeacademy.cc" }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "lifeacademy-media"
    }
  ]
}
